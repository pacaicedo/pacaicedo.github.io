\setbeamercolor{alerted text}{fg=caicedocausa}
\setbeamercolor{example text}{fg=caicedografo}
\setbeamercolor{frametitle}{fg=caicedotitulo}
\setbeamercolor{title}{fg=caicedotitulo}
\setbeamercolor{subtitle}{fg=caicedodato}
\setbeamercolor{author}{fg=caicedotitulo}
\setbeamercolor{date}{fg=caicedotenue}
\setbeamercolor{block title}{fg=caicedodato, bg=}
\setbeamercolor{block body}{fg=caicedotexto, bg=}
\setbeamercolor{block title alerted}{fg=caicedocausa, bg=}
\setbeamercolor{block title example}{fg=caicedografo, bg=}
\setbeamercolor{caption name}{fg=caicedotitulo}
\setbeamercolor{caption}{fg=caicedotenue}
\setbeamercolor{footnote}{fg=caicedotenue}
\setbeamercolor{footnote mark}{fg=caicedodato}
