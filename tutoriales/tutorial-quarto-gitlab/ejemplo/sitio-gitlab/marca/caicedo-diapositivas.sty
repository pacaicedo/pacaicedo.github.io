\newcommand*{\caicedofilete}[2]{% {ancho}{grueso}
  \tikz[baseline]{\shade[left color=cdato, right color=ccausa, middle color=cgrafo] (0,0) rectangle (#1,#2);}}

% ---------------------------------------------------------------- Título de diapositiva
% = h2 de revealjs: 36 px arriba, letra de 48 px (17.28 pt) con interlineado 1.12, 14 px de
% relleno con el filete de 80 × 4 px al fondo y 28 px de margen. El renglón lleva la caja de
% línea de CSS, así que ni el título ni el filete se mueven según las letras que tenga.
% beamer compone el título después del cuerpo: se anula el estado que este haya dejado.
\setbeamertemplate{frametitle}{%
  \global\caicedo@tras\z@
  \vspace*{\caicedo@arriba}%
  \setbox\z@\vbox{\caicedodisplay\linespread{1}\fontsize{17.28}{19.354}\selectfont
    \addfontfeature{LetterSpace=-1}\color{cink}\caicedo@puntal\insertframetitle\par
    \global\caicedo@tmp\caicedo@fondocss}%
  \dp\z@\caicedo@tmp \box\z@
  \nointerlineskip\vspace{1.25mm}%
  \hbox{\caicedofilete{10mm}{0.5mm}}}
\addtobeamertemplate{frametitle}{}{\vspace*{0mm}}

% ---------------------------------------------------------------- Pie
% Isotipo a la izquierda, texto mono en gris, número turquesa, barra degradada al pie.
% En la portada (fondo tinta) se usan las variantes claras: la portada activa
% \ifcaicedo@oscura y el pie la apaga al terminar.
\newif\ifcaicedo@oscura
\providecommand{\caicedopie}{P. E. Caicedo-Rodríguez\enspace·\enspace\insertshorttitle}
\setbeamertemplate{footline}{%
  \ifcaicedo@oscura
    \def\caicedo@pieiso{cmuteddk}\def\caicedo@pietxt{cmuteddk}\def\caicedo@pienum{cdato}%
  \else
    \def\caicedo@pieiso{cmuted}\def\caicedo@pietxt{cmuted}\def\caicedo@pienum{cdatod}%
  \fi
  \begin{tikzpicture}[x=1mm, y=1mm]
    \useasboundingbox (0,0) rectangle (\paperwidth,8);
    \shade[left color=cdato, right color=ccausa, middle color=cgrafo] (0,0) rectangle (\paperwidth,0.5);
    \node[anchor=south west, inner sep=0pt] at (2.75,1.9) {\caicedoisotipo[\caicedo@pieiso]{3.75mm}};
    \node[anchor=south west, inner sep=0pt] at (8,2.375)
      {\caicedomono\fontsize{5.3}{6.4}\selectfont\color{\caicedo@pietxt}\caicedopie};
    \node[anchor=south east, inner sep=0pt] at ([xshift=-2.75mm]\paperwidth,2.75)
      {\caicedomono\fontsize{5.3}{6.4}\selectfont\color{\caicedo@pienum}\insertframenumber\ /\ \inserttotalframenumber};
  \end{tikzpicture}%
  \global\caicedo@oscurafalse}

% ---------------------------------------------------------------- Portada
% = section#title-slide: página en tinta, motivo a la derecha (92 % del alto),
% velo de tinta, texto a la izquierda centrado en vertical.
\setbeamertemplate{title page}{%
  \global\caicedo@oscuratrue\global\caicedo@tras\z@
  \begin{tikzpicture}[remember picture, overlay]
    \fill[cink] (current page.south west) rectangle (current page.north east);
    \begin{scope}[shift={([xshift=5mm, yshift=0.46*90mm]current page.east)}]
      \setlength{\caicedo@u}{\dimexpr 0.92\paperheight/500\relax}%
      \begin{scope}[x=\caicedo@u, y=-\caicedo@u, shift={(-800,0)}]\caicedo@arte\end{scope}
    \end{scope}
    \fill[cink, opacity=0.92] (current page.south west) rectangle ([xshift=0.38\paperwidth]current page.north west);
    \fill[cink, opacity=0.92, path fading=east] ([xshift=0.38\paperwidth]current page.south west) rectangle ([xshift=0.70\paperwidth]current page.north west);
    \node[anchor=west, text width=0.62\paperwidth, align=left, inner sep=0pt]
      at ([xshift=8mm, yshift=2.5mm]current page.west) {%
        % Bandera a la izquierda, espacios naturales de cada fuente y sin guiones (como revealjs).
        \raggedright\spaceskip\z@\xspaceskip\z@\hyphenpenalty\@M\exhyphenpenalty\@M
        % Sobre tinta, la negrita conserva el color de su línea y el código va en dorado claro.
        \renewcommand{\textbf}[1]{\caicedo@textbf{##1}}\renewcommand{\texttt}[1]{{\color{ccausa}\caicedo@texttt{##1}}}%
        % Cada línea con su caja de CSS y, entre ellas, los márgenes de revealjs.
        \linespread{1}%
        \caicedo@linea{\caicedomono\fontsize{5.6}{7.555}\selectfont\color{cdato}\addfontfeature{LetterSpace=30}}{DEL DATO A LA CAUSA}%
        \vskip4.25mm
        \caicedo@linea{\caicedodisplay\bfseries\fontsize{24.88}{26.37}\selectfont\addfontfeature{LetterSpace=-1.5}\color{white}}{\inserttitle}%
        \vskip6.22pt
        \ifx\beamer@subtitle\@empty\else
          \caicedo@linea{\caicedodisplayreg\fontsize{12.3}{14.76}\selectfont\color{cdato}}{\insertsubtitle}%
          \vskip5mm
        \fi
        \ifx\beamer@shortauthor\@empty\else
          \caicedo@linea{\caicedodisplayreg\fontsize{9}{12.15}\selectfont\color{white}}{\insertauthor}%
          \vskip0.2mm
        \fi
        \ifx\insertinstitute\@empty\else
          \caicedo@linea{\fontsize{7.7}{10.395}\selectfont\color{cmuteddk}}{\insertinstitute}%
        \fi
        \ifx\beamer@shortdate\@empty\else
          \vskip0.75mm
          \caicedo@linea{\caicedomono\fontsize{7}{9.45}\selectfont\color{cmuteddk}\addfontfeature{LetterSpace=14}}{\MakeUppercase{\insertdate}}%
        \fi
      };
  \end{tikzpicture}}

% Un renglón (o párrafo) con cajas de línea de CSS arriba y abajo: {fuente}{texto}.
\newcommand{\caicedo@linea}[2]{\par\nointerlineskip{#1\caicedo@puntal#2\caicedo@puntalfondo\par}\nointerlineskip}
% Sin fecha en el qmd no hay fecha en la portada (beamer pondría la de hoy), como en revealjs.
\date{}

% ---------------------------------------------------------------- Separador de sección
% = section.level1 de revealjs: isotipo de 10 mm, título 21.9 pt, filete 20 × 0.5 mm, sobre blanco.
\AtBeginSection[]{%
  \begin{frame}
    \begin{tikzpicture}[remember picture, overlay]
      \node[anchor=center, align=center, inner sep=0pt] at ([yshift=1mm]current page.center) {%
        \global\caicedo@tras\z@\spaceskip\z@\xspaceskip\z@\hyphenpenalty\@M
        \caicedoisotipo{10mm}\\[3.5mm]
        {\caicedodisplay\bfseries\fontsize{21.9}{24}\selectfont\addfontfeature{LetterSpace=-1}\color{cink}\insertsectionhead}\\[-0.5mm]
        \caicedofilete{20mm}{0.5mm}};
    \end{tikzpicture}
  \end{frame}}

% ---------------------------------------------------------------- Texto
\let\caicedo@textbf\textbf
\renewcommand{\textbf}[1]{{\color{cink}\caicedo@textbf{#1}}}
\let\caicedo@texttt\texttt
\renewcommand{\texttt}[1]{{\color{ccausad}\caicedo@texttt{#1}}}

% ---------------------------------------------------------------- Listas
% Viñetas = nodos: turquesa, turquesa profundo y dorado.
\setbeamertemplate{itemize item}{\tikz[baseline=-0.62ex]\fill[cdatod] (0,0) circle (0.18em);}
\setbeamertemplate{itemize subitem}{\tikz[baseline=-0.62ex]\fill[cgrafod] (0,0) circle (0.15em);}
\setbeamertemplate{itemize subsubitem}{\tikz[baseline=-0.62ex]\fill[ccausad] (0,0) circle (0.15em);}
\setbeamertemplate{enumerate item}{{\caicedomono\color{cdatod}\insertenumlabel.}}
\setbeamertemplate{enumerate subitem}{{\caicedomono\color{cdatod}\insertsubenumlabel.}}
\setbeamertemplate{enumerate subsubitem}{{\caicedomono\color{cdatod}\insertsubsubenumlabel.}}
% Con etiqueta explícita (pandoc escribe [a.] o [i.]) beamer usa la «mini template».
\setbeamertemplate{enumerate mini template}{{\caicedomono\color{cdatod}\insertenumlabel}}
% Cada número al tamaño de su texto (11, 10 y 9 pt = 1em, .9em y .81em de revealjs).
\setbeamerfont{enumerate item}{size=\normalsize}
\setbeamerfont{enumerate subitem}{size=\fontsize{9.9}{12.24}\selectfont}
\setbeamerfont{enumerate subsubitem}{size=\fontsize{8.91}{11.016}\selectfont}
% Listas anidadas a .9em y .81em (9.9 y 8.91 pt), interlineado 1.35 como el texto.
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{9.9}{12.24}\selectfont}
\setbeamerfont{itemize/enumerate subsubbody}{size=\fontsize{8.91}{11.016}\selectfont}
\setlength{\leftmargini}{1.05em}
% Niveles 2 y 3 = padding-left 1.05em de los ul anidados, que van a .9em y .81em.
\setlength{\leftmarginii}{10.4pt}
\setlength{\leftmarginiii}{9.35pt}
% Espacio entre elementos = margen de los <li> de revealjs (.4em): 4.4 pt en el
% primer nivel y 3.96 pt en el segundo (a .9em). Sin elasticidad, como CSS.
\def\@listi{\leftmargin\leftmargini \topsep 4.4\p@ \parsep\z@ \itemsep 4.4\p@}
\let\@listI\@listi
\def\@listii{\leftmargin\leftmarginii \topsep 3.96\p@ \parsep\z@ \itemsep 3.96\p@}
\def\@listiii{\leftmargin\leftmarginiii \topsep 3.96\p@ \parsep\z@ \itemsep 3.96\p@}
% Pandoc marca las listas compactas con \tightlist; aquí no cambia el espaciado.
\AtBeginDocument{\renewcommand{\tightlist}{\setlength{\parskip}{0pt}}}
% Entre párrafos, el margen de 12 px de los <p> de revealjs.
\newlength\caicedo@parskip \setlength\caicedo@parskip{4.268pt}
\AtBeginDocument{\setlength{\parskip}{\caicedo@parskip}}
% Tras una lista de primer nivel, el margen inferior del <ul>/<ol> y del último <li>
% de revealjs (.5em + .2em). Se suma al espacio de lo que sigue, como en el navegador.
\AtEndEnvironment{itemize}{\ifnum\@listdepth=\@ne\par\addvspace{11.97pt}\fi}
\AtEndEnvironment{enumerate}{\ifnum\@listdepth=\@ne\par\addvspace{11.97pt}\fi}
\setlength{\parindent}{0pt}
\AtBeginDocument{\setlength{\parindent}{0pt}}
% Listas de definiciones = <dl> de revealjs: término en negrita (tinta), definición
% sangrada 1.05em en el renglón siguiente y .4em tras cada definición.
\newdimen\caicedo@izq
\renewenvironment{description}{%
  \par\begingroup\let\caicedo@dtsep\@empty
  \def\item{\@ifnextchar[\caicedo@dt{\caicedo@dt[]}}}%
  {\par\endgroup}
\def\caicedo@dt[#1]{\par\caicedo@dtsep\def\caicedo@dtsep{\vskip4.4\p@}%
  {\ifdim\leftskip=\caicedo@izq\parskip\caicedo@parskip\else\parskip\z@\fi\leftskip\caicedo@izq
   \noindent\caicedo@textbf{\color{cink}#1}\par}%
  \parskip\z@\leftskip\dimexpr\caicedo@izq+11.55\p@\relax\ignorespaces}

% ---------------------------------------------------------------- Espaciado de CSS
% revealjs coloca cada renglón en una caja de línea (alto = interlineado, con la base a
% medio interlineado bajo la ascendente) y separa los bloques con márgenes que colapsan.
% TeX apila renglones según sus letras. Para que coincidan, el primer renglón de lo que
% sigue a un bloque «con borde» (título, caja, comienzo de columna o de diapositiva) lleva
% un puntal con el alto de la caja de línea, sin interlineado de TeX encima, y el espacio
% se calcula como en CSS a partir del margen inferior pendiente (\caicedo@margen):
%   párrafo: max(margen, 12 px) · lista: margen + .4em del <li> · h3 y cajas: max(margen, el suyo).
% DejaVu: ascendente .9282 em y descendente .2358 em; el ajuste de -0.2 pt recoge el
% redondeo de Chrome al situar la base.
\newdimen\caicedo@ajuste \caicedo@ajuste=-0.2pt
\newcommand*{\caicedo@altocss}{\dimexpr(\baselineskip+.6924em)/2+\caicedo@ajuste\relax}
\newcommand*{\caicedo@fondocss}{\dimexpr\baselineskip-\caicedo@altocss\relax}
\newcommand*{\caicedo@puntal}{\leavevmode\vrule\@height\caicedo@altocss\@width\z@}
\newcommand*{\caicedo@puntalfondo}{%
  \ifhmode\vrule\@depth\caicedo@fondocss\@width\z@
  \else\ifdim\prevdepth>-1000\p@\ifdim\prevdepth<\caicedo@fondocss
    \kern\dimexpr\caicedo@fondocss-\prevdepth\relax\prevdepth\caicedo@fondocss\fi\fi\fi}
\newdimen\caicedo@mp \caicedo@mp=4.268pt   % margen de un <p>: 12 px
\newdimen\caicedo@margen
\newdimen\caicedo@tmp
\newdimen\caicedo@arriba \caicedo@arriba=8.78pt
% Del fondo del filete al primer bloque hay 28 px en revealjs; en beamer median 0.25em y
% \beamer@frametopskip (.2cm), y el cuerpo empieza con \vskip-\parskip\vbox{}: falta
% \caicedo@inicio.
\newdimen\caicedo@inicio \caicedo@inicio=1.38pt
% \caicedo@tras: 0 = tras texto (TeX ya pone el interlineado), 1 = tras un bloque con borde,
% 2 = arriba de una caja (sin margen previo), 3 = comienzo del cuerpo de la diapositiva.
\newcount\caicedo@tras
\newif\ifcaicedo@titulo
\newif\ifcaicedo@puntal
\newcommand*{\caicedo@trascaja}[1]{\global\caicedo@margen=#1\relax\global\caicedo@tras\@ne}
% LaTeX ejecuta para/before en modo vertical, ya puesto el \parskip y antes del renglón:
% ahí va el espacio (y se anula el interlineado, que los anclas \phantomsection de pandoc
% alterarían); en para/begin, ya en el párrafo, el puntal.
\AddToHook{para/before}{\ifnum\caicedo@tras>\z@\caicedo@espacio\fi}
\AddToHook{para/begin}{\ifcaicedo@puntal\global\caicedo@puntalfalse
  \vrule\@height\caicedo@altocss\@width\z@\fi}
\newcommand*{\caicedo@espacio}{%
  \ifnum\caicedo@tras=\tw@
    \ifnum\@listdepth>\z@\vskip\topsep\fi
  \else
    \vskip\dimexpr
      \ifnum\caicedo@tras=\@ne
        \ifcaicedo@titulo\caicedo@margen-\parskip
        \else\ifnum\@listdepth>\z@\caicedo@margen-\caicedo@parskip
        \else\ifdim\caicedo@margen<\caicedo@mp\caicedo@mp\else\caicedo@margen\fi-\parskip\fi\fi
      \else
        \caicedo@inicio
      \fi\relax
  \fi
  \nointerlineskip
  \global\caicedo@puntaltrue
  \global\caicedo@tras\z@}
\AddToHook{env/beamer@framepauses/begin}{\global\caicedo@tras\thr@@\global\caicedo@puntalfalse}
% Tablas = <table> de revealjs: una caja sin márgenes. Encima, el margen de lo anterior (texto:
% 12 px desde el fondo de su caja de línea); debajo, lo que siga pone el suyo.
\AtBeginEnvironment{longtable}{%
  \ifcase\caicedo@tras\par\addvspace{\caicedo@mp}\caicedo@hastafondo\setlength\LTpre{\z@}%
  \or\setlength\LTpre{\caicedo@margen}%
  \or\setlength\LTpre{\z@}%
  \or\setlength\LTpre{\dimexpr\caicedo@inicio+\caicedo@parskip\relax}\fi
  \setlength\LTpost{\z@}\global\caicedo@tras\z@}
\AfterEndEnvironment{longtable}{\caicedo@trascaja{\z@}}

% Cajas (código, citas, callouts): \caicedo@antes{margen superior} y \caicedo@despues{margen inferior}.
% tcolorbox compone el contenido antes de ejecutar «before», así que el estado se guarda al
% abrir la caja (clave code=\caicedo@guardar), en el grupo de la caja.
\newdimen\caicedo@margenc
\def\caicedo@trasc{0}
\newcommand*{\caicedo@guardar}{\edef\caicedo@trasc{\the\caicedo@tras}\caicedo@margenc=\caicedo@margen
  \global\caicedo@tras\z@}
\newcommand*{\caicedo@antes}[1]{%
  \ifnum\lastnodetype=-1\relax\else
    \par
    \ifvmode
      \ifnum\caicedo@trasc=\@ne
        \vskip\dimexpr\ifdim\caicedo@margenc<#1 #1\else\caicedo@margenc\fi-\parskip\relax
      \else\ifnum\caicedo@trasc=\thr@@
        \vskip\caicedo@inicio
      \else\ifnum\caicedo@trasc=\z@
        \iftcb@minipage\else
          \addvspace{\glueexpr\dimexpr\caicedo@fondocss-\ifdim\prevdepth<\z@\z@\else\prevdepth\fi
            +\ifdim#1<\caicedo@mp\caicedo@mp\else#1\fi-\parskip\relax\relax}%
        \fi
      \fi\fi\fi
      \nointerlineskip
    \fi
  \fi
  \global\caicedo@tras\z@
  \lineskip\z@skip\noindent}
\newcommand*{\caicedo@despues}[1]{%
  \tcb@parfillskip@check\par
  \ifvmode\nointerlineskip\fi
  \caicedo@trascaja{#1}}
% Primer renglón dentro de la caja: arriba del todo, con su caja de línea.
\newcommand*{\caicedo@arribacaja}{\global\caicedo@tras\tw@}
% Completa el renglón anterior hasta el fondo de su caja de línea de CSS (para lo que sigue
% sin interlineado: títulos de bloque y tablas).
\newcommand*{\caicedo@hastafondo}{\ifdim\prevdepth>-1000\p@\ifdim\prevdepth<\caicedo@fondocss
  \vskip\dimexpr\caicedo@fondocss-\prevdepth\relax\fi\fi}

% ---------------------------------------------------------------- Subtítulos y bloques
% ### dentro de una diapositiva = block de beamer = h3 de revealjs (turquesa oscuro, 12 pt,
% interlineado 1.12, sin margen superior y 12 px de margen inferior).
\setbeamerfont{block title}{family=\caicedodisplay, size=\linespread{1}\fontsize{12}{13.44}\selectfont}
\setbeamertemplate{blocks}[default]
\setbeamertemplate{block begin}{%
  \par
  {\ifnum\caicedo@tras=\z@\addvspace{\caicedo@mp}\caicedo@hastafondo\parskip\z@\caicedo@trascaja{\z@}\fi
   \caicedo@titulotrue\usebeamercolor[fg]{block title}\usebeamerfont{block title}%
   \insertblocktitle\caicedo@puntalfondo\par}%
  \nointerlineskip\caicedo@trascaja{\caicedo@mp}%
  \usebeamercolor[fg]{block body}}
\setbeamertemplate{block end}{\par}

% ---------------------------------------------------------------- Código
\AtBeginDocument{%
  \@ifundefined{Shaded}{}{%
    \renewenvironment{Shaded}{\begin{caicedocodigo}}{\end{caicedocodigo}}}}
% = pre de revealjs: letra de 8.8 pt (.8em), interlineado 1.4, relleno .5em .7em (más el filo).
% Cada línea lleva la caja de línea de CSS (1.4 × 8.8 pt). El <pre> no tiene margen.
\newcommand*{\caicedo@lineasconpuntal}{\renewcommand{\FancyVerbFormatLine}[1]{%
  \vrule\@height\caicedo@altocss\@depth\caicedo@fondocss\@width\z@##1}}
\newtcolorbox{caicedocodigo}{breakable, enhanced, frame hidden, boxrule=0pt, boxsep=0pt,
  colback=cpaper, colupper=ctext, arc=0.75mm, borderline west={0.375mm}{0pt}{cdatod},
  code=\caicedo@guardar, before upper=\caicedo@lineasconpuntal,
  left=7.23pt, right=6.16pt, top=4.4pt, bottom=4.4pt, before={\caicedo@antes{\z@}}, after={\caicedo@despues{\z@}}, halign=flush left,
  fontupper=\linespread{1}\fontsize{9.78}{12.32}\selectfont}

% ---------------------------------------------------------------- Tablas (booktabs)
\setlength{\heavyrulewidth}{0.25mm}
\setlength{\lightrulewidth}{0.125mm}
% Sin aire extra junto a los filetes: las filas miden lo mismo que en revealjs.
\setlength{\abovetopsep}{0pt}\setlength{\belowrulesep}{0pt}\setlength{\aboverulesep}{0pt}\setlength{\belowbottomsep}{0pt}
\renewcommand{\arraystretch}{1.25}
\AtBeginEnvironment{longtable}{\footnotesize\arrayrulecolor{cink}}
% Alineada a la izquierda, como en revealjs.
\setlength{\LTleft}{0pt}\setlength{\LTright}{\fill}

% ---------------------------------------------------------------- Columnas
% Pandoc escribe \begin{columns}[T]. Dentro de cada columna (una minipage) se recupera
% el \parskip y el contenido arranca a la altura del de revealjs.
\define@key{beamer@col}{T}[true]{\def\beamer@colmode{T}\def\beamer@colalign{t}%
  \def\beamer@colheadskip{\setlength\parskip{\caicedo@parskip}%
    \par\kern\caicedo@colarriba\nointerlineskip\@minipagefalse\caicedo@encolumnatrue\caicedo@trascaja{\z@}%
    \caicedo@colmargenes}}
\newif\ifcaicedo@encolumna
% Márgenes laterales de lo que hay en cada columna (= .reveal .columns > .column > :not(ul, ol)):
% .5rem (1 mm) hacia la columna vecina y .25rem por lado en las centrales. Párrafos y títulos
% los toman de \leftskip/\rightskip, y las cajas (que van en un párrafo) además se estrechan; las listas no llevan.
\newdimen\caicedo@colml \newdimen\caicedo@colmr
\newdimen\caicedo@colacum \newdimen\caicedo@coltotal
\newcommand*{\caicedo@colmargenes}{%
  \ifdim\caicedo@colacum<\p@\caicedo@colml\z@\caicedo@colmr1mm\else\caicedo@colml.5mm\caicedo@colmr.5mm\fi
  \ifdim\dimexpr\caicedo@colacum+\linewidth\relax>\dimexpr\caicedo@coltotal-\p@\relax
    \caicedo@colml1mm\caicedo@colmr\z@\fi
  \global\advance\caicedo@colacum\linewidth
  \caicedo@izq\caicedo@colml\leftskip\caicedo@colml\rightskip\caicedo@colmr\@plus1fil\relax
  \tcbset{every box on layer 1/.append style={width=\linewidth-\caicedo@colml-\caicedo@colmr}}}
\AtBeginEnvironment{itemize}{\ifcaicedo@encolumna\caicedo@izq\z@\leftskip\z@\rightskip\@flushglue\fi}
\AtBeginEnvironment{enumerate}{\ifcaicedo@encolumna\caicedo@izq\z@\leftskip\z@\rightskip\@flushglue\fi}
% Cada columna (minipage) empieza sin estado heredado de la anterior y acaba con el margen
% inferior de su último bloque, que en revealjs queda dentro de la columna (flex).
\AddToHook{env/minipage/begin}{\global\caicedo@tras\z@}
\AddToHook{env/minipage/end}{\ifcaicedo@encolumna\par
  \ifnum\caicedo@tras=\@ne\vskip\caicedo@margen
  \else\vskip\dimexpr\caicedo@fondocss-\ifdim\prevdepth<\z@\z@\else\prevdepth\fi+\caicedo@mp\relax\fi
  \global\caicedo@tras\z@\fi}
\AfterEndEnvironment{columns}{\par\nointerlineskip\caicedo@trascaja{\caicedo@mp}}
\newdimen\caicedo@colarriba \caicedo@colarriba=\z@
% El bloque de columnas empieza donde empezaría una caja sin margen (= div.columns de
% revealjs, un flex sin margen); dentro, los márgenes no colapsan con los de fuera.
\BeforeBeginEnvironment{columns}{\par\global\caicedo@coltotal\linewidth\global\caicedo@colacum\z@
  \ifnum\caicedo@tras=\@ne\vskip\caicedo@margen
  \else\ifnum\caicedo@tras=\thr@@\vskip\dimexpr\caicedo@inicio+\caicedo@parskip\relax
  \else\addvspace{\dimexpr\caicedo@fondocss-\ifdim\prevdepth<\z@\z@\else\prevdepth\fi+\caicedo@mp\relax}\fi\fi
  \nointerlineskip\global\caicedo@tras\z@}
\define@key{beamer@col}{c}[true]{\def\beamer@colmode{c}\def\beamer@colalign{c}%
  \def\beamer@colheadskip{\setlength\parskip{\caicedo@parskip}\caicedo@colmargenes}}
\define@key{beamer@col}{t}[true]{\def\beamer@colmode{t}\def\beamer@colalign{t}%
  \def\beamer@colheadskip{\setlength\parskip{\caicedo@parskip}\caicedo@colmargenes}}
\define@key{beamer@col}{b}[true]{\def\beamer@colmode{b}\def\beamer@colalign{b}%
  \def\beamer@colheadskip{\setlength\parskip{\caicedo@parskip}\caicedo@colmargenes}}
\AtBeginEnvironment{tabular}{\footnotesize\arrayrulecolor{cink}}

% ---------------------------------------------------------------- Citas
% = blockquote de revealjs: relleno .5em .9em (más el filo), margen .6em.
\newtcolorbox{caicedocita}{enhanced, frame hidden, boxrule=0pt, boxsep=0pt, sharp corners,
  colback=ccausa!10!white, colupper=ctext, borderline west={0.375mm}{0pt}{ccausad},
  left=10.97pt, right=9.9pt, top=5.5pt, bottom=5.5pt, before={\caicedo@antes{6.6pt}}, after={\caicedo@despues{6.6pt}}, halign=flush left,
  code=\caicedo@guardar, before upper=\caicedo@arribacaja, after upper=\caicedo@puntalfondo}
\renewenvironment{quote}{\begin{caicedocita}}{\end{caicedocita}}

% ---------------------------------------------------------------- Callouts de Quarto
% Quarto los dibuja con tcolorbox de borde completo. Aquí llevan fondo papel,
% solo el filo izquierdo y el título sobre un tinte del 12 % del color del tipo:
% así coinciden con los callouts de revealjs.
\AtBeginDocument{%
  \definecolor{quarto-callout-note-color}{HTML}{1A7C78}\definecolor{quarto-callout-note-color-frame}{HTML}{1A7C78}%
  \definecolor{quarto-callout-tip-color}{HTML}{1D6468}\definecolor{quarto-callout-tip-color-frame}{HTML}{1D6468}%
  \definecolor{quarto-callout-important-color}{HTML}{97650A}\definecolor{quarto-callout-important-color-frame}{HTML}{97650A}%
  \definecolor{quarto-callout-warning-color}{HTML}{C4432C}\definecolor{quarto-callout-warning-color-frame}{HTML}{C4432C}%
  \definecolor{quarto-callout-caution-color}{HTML}{C4432C}\definecolor{quarto-callout-caution-color-frame}{HTML}{C4432C}%
  \definecolor{quarto-callout-color}{HTML}{315064}\definecolor{quarto-callout-color-frame}{HTML}{315064}}
% Al abrir cada caja «tcolorbox» (las de Quarto) se fijan los valores de la marca
% y se anulan las claves con que Quarto las pinta. El color
% del título se deriva del color del filo, como en revealjs.
\newcommand*{\caicedo@callouthook}{%
  % Medidas = callout de revealjs: título con relleno .12em (más el alto del icono), cuerpo .3em/.32em,
  % lados .45em, interlineado 1.3 y margen .6em.
  \tcbset{colback=cpaper, opacityback=1, colupper=ctext, coltitle=cink,
    opacitybacktitle=1, toprule=0pt, bottomrule=0pt, rightrule=0pt, leftrule=0.5mm,
    boxsep=0pt, left=4.95pt, right=4.95pt, top=3.3pt, bottom=3.52pt,
    lefttitle=4.95pt, righttitle=4.95pt, toptitle=1.32pt, bottomtitle=1.32pt,
    before={\caicedo@antes{6.6pt}}, after={\caicedo@despues{6.6pt}}, halign=flush left, halign title=flush left,
    fonttitle=\caicedodisplay\linespread{1}\fontsize{11}{14.3}\selectfont,
    before title=\caicedo@puntal, after title=\caicedo@puntalfondo,
    fontupper=\linespread{1}\fontsize{11}{14.3}\selectfont,
    before upper=\caicedo@arribacaja, after upper=\caicedo@puntalfondo, code=\caicedo@guardar}%
  \tcbset{colback/.code={}, opacityback/.code={}, colupper/.code={}, coltitle/.code={},
    opacitybacktitle/.code={}, @colbacktitle/.code={}, toprule/.code={}, bottomrule/.code={},
    rightrule/.code={}, leftrule/.code={}, left/.code={}, toptitle/.code={}, bottomtitle/.code={},
    colframe/.code={\colorlet{tcbcolframe}{##1}\colorlet{tcbcolbacktitle}{##1!12!white}}}}
\AddToHook{env/tcolorbox/begin}{\caicedo@callouthook}
% Iconos de los callouts = los de revealjs: trazados de Bootstrap Icons (info-circle, lightbulb,
% exclamation-circle, exclamation-triangle, cone-striped) en lugar de los macizos de Font Awesome
% que usa Quarto en PDF. \smash: no alteran el alto del título. Tamaño, altura y avance
% (con el \hspace{.5em} de Quarto) = los del icono de revealjs.
\newcommand*{\caicedo@bi}[1]{\smash{\tikz[baseline=-1.145em, x=0.0789em, y=-0.0789em]{%
