% ---------------------------------------------------------------- Letra
% Atkinson Hyperlegible Next (texto) y Mono (código), del Braille Institute, licencia SIL OFL
% (recursos/marca/fuentes/OFL-*.txt). En diapositivas el texto va en peso medio (500) y la
% negrita en extranegrita (800): el trazo resiste proyectores débiles. Lo que Atkinson no trae
% (griego, flechas, algunos símbolos) sale de DejaVu Sans con el respaldo de luaotfload.
\usefonttheme{professionalfonts}
% Las fuentes están en la carpeta fuentes/ junto a este .sty; \caicedofuentes solo hace falta
% si se movieron (\newcommand*{\caicedofuentes}{ruta/} antes del \usepackage).
\ifdefined\caicedofuentes\else\edef\caicedofuentes{\ifx\caicedo@dir\@empty\else\caicedo@dir/\fi fuentes/}\fi
% Si las fuentes están instaladas en el sistema se cargan por nombre; si no, desde
% \caicedofuentes convertida en ruta absoluta. luaotfload guarda en caché la ruta con la que
% cargó cada fuente la primera vez: con una ruta relativa, otro documento compilado desde
% otra carpeta no encontraría el archivo («cannot find file ''»).
\ifdefined\directlua
  \edef\caicedofuentes{\directlua{
    local p = "\luaescapestring{\caicedofuentes}"
    if not (p:match("^/") or p:match("^[A-Za-z]:")) then
      p = lfs.currentdir():gsub("\string\\", "/") .. "/" .. p
    end
    tex.sprint(-2, p)}}
\fi
\IfFontExistsTF{AtkinsonHyperlegibleNext-Regular}
  {\def\caicedo@ruta{}\def\caicedo@rutam{}}
  {\edef\caicedo@ruta{Path=\caicedofuentes, Extension=.ttf,}\let\caicedo@rutam\caicedo@ruta}
\ifdefined\directlua
  \IfFontExistsTF{DejaVuSans}{\def\caicedo@dv{name:}\def\caicedo@dva{}\def\caicedo@dvb{}}
    {\def\caicedo@dv{}\edef\caicedo@dva{[\caicedofuentes}\def\caicedo@dvb{.ttf]}}
  \directlua{
    local function f(n) return "\caicedo@dv" .. "\caicedo@dva" .. n .. "\caicedo@dvb" .. ":mode=node;" end
    luaotfload.add_fallback("caicedorespaldo", {f("DejaVuSans")})
    luaotfload.add_fallback("caicedorespaldob", {f("DejaVuSans-Bold")})
    luaotfload.add_fallback("caicedorespaldom", {f("DejaVuSansMono")})}
  \def\caicedo@fb{RawFeature={fallback=caicedorespaldo}}
  \def\caicedo@fbb{RawFeature={fallback=caicedorespaldob}}
  \def\caicedo@fbm{RawFeature={fallback=caicedorespaldom}}
\else
  \def\caicedo@fb{}\def\caicedo@fbb{}\def\caicedo@fbm{}
\fi
% WordSpace={1,1,0}: los espacios no se encogen, como en el navegador, así las líneas
% cortan en las mismas palabras que en revealjs.
\edef\caicedo@tmpa{%
  \noexpand\setmainfont{AtkinsonHyperlegibleNext}[\caicedo@ruta Scale=1, WordSpace={1,1,0},
    UprightFont=*-Medium, BoldFont=*-ExtraBold, ItalicFont=*-MediumItalic, BoldItalicFont=*-ExtraBoldItalic,
    UprightFeatures={\caicedo@fb}, ItalicFeatures={\caicedo@fb}, BoldFeatures={\caicedo@fbb}, BoldItalicFeatures={\caicedo@fbb}]%
  \noexpand\setsansfont{AtkinsonHyperlegibleNext}[\caicedo@ruta Scale=1, WordSpace={1,1,0},
    UprightFont=*-Medium, BoldFont=*-ExtraBold, ItalicFont=*-MediumItalic, BoldItalicFont=*-ExtraBoldItalic,
    UprightFeatures={\caicedo@fb}, ItalicFeatures={\caicedo@fb}, BoldFeatures={\caicedo@fbb}, BoldItalicFeatures={\caicedo@fbb}]%
  \noexpand\setmonofont{AtkinsonHyperlegibleMono}[\caicedo@rutam Scale=1,
    UprightFont=*-Medium, BoldFont=*-Bold, ItalicFont=*-MediumItalic, BoldItalicFont=*-BoldItalic,
    UprightFeatures={\caicedo@fbm}, ItalicFeatures={\caicedo@fbm}, BoldFeatures={\caicedo@fbm}, BoldItalicFeatures={\caicedo@fbm}]%
  \noexpand\newfontfamily\noexpand\caicedodisplay{AtkinsonHyperlegibleNext}[\caicedo@ruta Scale=1, WordSpace={1,1,0},
    UprightFont=*-ExtraBold, BoldFont=*-ExtraBold, ItalicFont=*-ExtraBoldItalic, BoldItalicFont=*-ExtraBoldItalic,
    UprightFeatures={\caicedo@fbb}, BoldFeatures={\caicedo@fbb}, ItalicFeatures={\caicedo@fbb}, BoldItalicFeatures={\caicedo@fbb}]}
\caicedo@tmpa
% La marca está calibrada para fontsize: 12pt (= 33.75 px de revealjs).
\AtBeginDocument{\begingroup\normalsize\ifdim\f@size pt=12pt\else
  \PackageWarningNoLine{caicedo-diapositivas}{La marca está calibrada para fontsize: 12pt;\MessageBreak
    con \f@size pt beamer y revealjs no cortarán igual las líneas}\fi\endgroup}
% Interlineado = line-height 1.35 de revealjs: 16.2 pt (beamer usa 14.5 pt a 12 pt).
\linespread{1.117241}
% Quarto carga microtype: su protrusión y expansión dejan que beamer meta en una línea
% texto que en el navegador ya no cabe. Se apagan para que los cortes coincidan.
\@ifpackageloaded{microtype}{\microtypesetup{protrusion=false, expansion=false}}{}

