\newlength{\caicedo@u}
\newlength{\caicedo@isou}
\newcommand*{\caicedo@colores@claro}{\colorlet{caicedo@tinta}{ctinta}\colorlet{caicedo@tenue}{ctenue}%
  \colorlet{caicedo@dato}{cdato}\colorlet{caicedo@causa}{ccausa}\colorlet{caicedo@grafo}{cgrafo}\colorlet{caicedo@hueco}{white}}
\newcommand*{\caicedo@colores@oscuro}{\colorlet{caicedo@tinta}{cluz}\colorlet{caicedo@tenue}{ctenueluz}%
  \colorlet{caicedo@dato}{cdato}\colorlet{caicedo@causa}{ccausa}\colorlet{caicedo@grafo}{cgrafoluz}\colorlet{caicedo@hueco}{csala}}
\newcommand*{\caicedo@colores@noche}{\caicedo@colores@oscuro\colorlet{caicedo@hueco}{cnoche}}
\caicedo@colores@claro
\newcommand*{\caicedo@arte}{%
@@MOTIVO_TIKZ@@
}
% \caicedoisotipo[claro|oscuro|noche]{tamaño}
\newcommand*{\caicedoisotipo}[2][claro]{%
  \begingroup\csname caicedo@colores@#1\endcsname
  \setlength{\caicedo@isou}{\dimexpr #2/64\relax}%
  \begin{tikzpicture}[x=\caicedo@isou, y=-\caicedo@isou, baseline=(current bounding box.south)]
  \useasboundingbox (0,0) rectangle (64,64);
@@ISO_TIKZ@@
  \end{tikzpicture}\endgroup}
% \caicedomotivo[claro|oscuro|noche]{ancho}: «de x[n] a la causa» (lienzo 1500 × 340).
\newcommand*{\caicedomotivo}[2][claro]{%
  \begingroup\csname caicedo@colores@#1\endcsname
  \setlength{\caicedo@u}{\dimexpr #2/1500\relax}%
  \begin{tikzpicture}[x=\caicedo@u, y=-\caicedo@u]\useasboundingbox (0,0) rectangle (1500,340);\caicedo@arte\end{tikzpicture}\endgroup}
% \caicedobarra{largo}: barra causal (dato, hueco, causa con punta); alto = largo × 6/108.
\newcommand*{\caicedobarra}[1]{%
  \begingroup\setlength{\caicedo@u}{\dimexpr #1/108\relax}%
  \tikz[x=\caicedo@u, y=-\caicedo@u, baseline=0pt]{%
    \fill[cdato] (0,4.2) rectangle (64,10.2); \fill[ccausa] (71,4.2) rectangle (93,10.2);
    \fill[ccausa] (92,0) -- (108,7.2) -- (92,14.4) -- cycle;}\endgroup}
% Compatibilidad con la v1: \caicedofilete{ancho}{grueso} dibuja ahora la barra causal.
\newcommand*{\caicedofilete}[2]{\caicedobarra{#1}}

% ---------------------------------------------------------------- Título de diapositiva
% = h2 de revealjs: 40 px arriba, letra de 54 px (19.2 pt) con interlineado 1.08, 24 px de
% relleno con la barra causal (108 × 14.4 px) al fondo y 28 px de margen.
\setbeamertemplate{frametitle}{%
  \global\caicedo@tras\z@
  \vspace*{\caicedo@arriba}%
  \setbox\z@\vbox{\caicedodisplay\linespread{1}\fontsize{19.2}{20.736}\selectfont
    \color{caicedotitulo}\caicedo@puntal\insertframetitle\par
    \global\caicedo@tmp\caicedo@fondocss}%
  \dp\z@\caicedo@tmp \box\z@
  \nointerlineskip\vspace{\dimexpr 24\caicedo@px-14.4\caicedo@px\relax}%
  \hbox{\caicedobarra{108\caicedo@px}}}
\addtobeamertemplate{frametitle}{}{\vspace*{0mm}}

% ---------------------------------------------------------------- Pie
% Firma (isotipo + nombre) a la izquierda; título corto y número a la derecha.
% Sobre fondo oscuro (portada en sala oscura, separadores) se usan las variantes luz.
\newif\ifcaicedo@pieoscuro
\providecommand{\caicedopie}{\insertshorttitle}
\newcommand*{\caicedo@firma}[1]{% {claro|oscuro|noche}
  \begingroup\edef\caicedo@tmpb{#1}\def\caicedo@tmpc{claro}%
  \ifx\caicedo@tmpb\caicedo@tmpc\color{ctinta}\else\color{cluz}\fi
  \raisebox{0pt}{\caicedoisotipo[#1]{4mm}}\hspace{0.875mm}%
  \raisebox{1.43mm}{\caicedodisplay\fontsize{6.4}{6.4}\selectfont P.\,E. Caicedo-Rodríguez}\endgroup}
\setbeamertemplate{footline}{%
  \ifcaicedo@sala\caicedo@pieoscurotrue\fi
  \ifcaicedo@pieoscuro
    \def\caicedo@piemodo{noche}\def\caicedo@pietxt{ctenueluz}\def\caicedo@pienum{cluz}%
  \else
    \def\caicedo@piemodo{claro}\def\caicedo@pietxt{caicedotenue}\def\caicedo@pienum{caicedotitulo}%
  \fi
  \begin{tikzpicture}[x=1mm, y=1mm]
    \useasboundingbox (0,0) rectangle (\paperwidth,9);
    \node[anchor=south west, inner sep=0pt] at (3,2.25) {\expandafter\caicedo@firma\expandafter{\caicedo@piemodo}};
    \node[anchor=base east, inner sep=0pt] at ([xshift=-16.5mm]\paperwidth,3.4)
      {\fontsize{7.47}{8.96}\selectfont\color{\caicedo@pietxt}\caicedopie};
    \node[anchor=base east, inner sep=0pt] at ([xshift=-3.5mm]\paperwidth,3.4)
      {\fontsize{7.47}{8.96}\selectfont\addfontfeature{Numbers={Monospaced,Lining}}{\caicedodisplay\color{\caicedo@pienum}\insertframenumber}\hspace{.3em}{\color{\caicedo@pietxt}/}\hspace{.3em}{\caicedodisplay\color{\caicedo@pienum}\inserttotalframenumber}};
  \end{tikzpicture}%
  \global\caicedo@pieoscurofalse}

% ---------------------------------------------------------------- Portada
% = section#title-slide: fondo de portada, texto arriba a la izquierda (72 px = 9 mm del borde
% superior) y el motivo abajo a la derecha (980 px = 122.5 mm de ancho, a 5.5 mm del borde
% derecho y 8.25 mm del inferior).
\setbeamertemplate{title page}{%
  \ifcaicedo@sala\global\caicedo@pieoscurotrue\fi\global\caicedo@tras\z@
  \begin{tikzpicture}[remember picture, overlay]
    \fill[caicedoportada] (current page.south west) rectangle (current page.north east);
    \node[anchor=south east, inner sep=0pt] at ([xshift=-5.5mm, yshift=8.25mm]current page.south east)
      {\ifcaicedo@sala\caicedomotivo[oscuro]{122.5mm}\else\caicedomotivo[claro]{122.5mm}\fi};
    \node[anchor=north west, text width=144mm, align=left, inner sep=0pt]
      at ([xshift=8mm, yshift=-9mm]current page.north west) {%
        % Bandera a la izquierda, espacios naturales de cada fuente y sin guiones (como revealjs).
        \raggedright\spaceskip\z@\xspaceskip\z@\hyphenpenalty\@M\exhyphenpenalty\@M
        \linespread{1}%
        \caicedo@linea{\caicedodisplay\fontsize{28}{29.12}\selectfont\color{caicedotitulo}}{\inserttitle}%
        \vskip 2.25mm
        \ifx\beamer@subtitle\@empty\else
          \caicedo@linea{\fontsize{13.19}{15.83}\selectfont\color{caicedodato}}{\insertsubtitle}%
          \vskip 4.25mm
        \fi
        \ifx\beamer@shortauthor\@empty\else
          \caicedo@linea{\caicedodisplay\fontsize{10.67}{14.4}\selectfont\color{caicedotitulo}}{\insertauthor}%
        \fi
        \ifx\insertinstitute\@empty\else
          \vskip 0.25mm
          \caicedo@linea{\fontsize{9}{12.15}\selectfont\color{caicedotenue}}{\insertinstitute}%
        \fi
        \ifx\beamer@shortdate\@empty\else
          \vskip 0.75mm
          \caicedo@linea{\fontsize{9}{12.15}\selectfont\color{caicedotenue}}{\insertdate}%
        \fi
      };
  \end{tikzpicture}}

% Un renglón (o párrafo) con cajas de línea de CSS arriba y abajo: {fuente}{texto}.
\newcommand{\caicedo@linea}[2]{\par\nointerlineskip{#1\caicedo@puntal#2\caicedo@puntalfondo\par}\nointerlineskip}
% Sin fecha en el qmd no hay fecha en la portada (beamer pondría la de hoy), como en revealjs.
\date{}

% ---------------------------------------------------------------- Separador de sección
% = section.level1 de revealjs con el filtro caicedo.lua: página en noche, título de 72 px
% (25.6 pt) alineado a la izquierda y barra causal de 144 px (18 mm) debajo.
\AtBeginSection[]{%
  {\setbeamercolor{background canvas}{bg=cnoche}%
  \begin{frame}
    \global\caicedo@pieoscurotrue
    \begin{tikzpicture}[remember picture, overlay]
      \node[anchor=west, text width=144mm, align=left, inner sep=0pt] at ([xshift=8mm, yshift=\caicedo@secy]current page.west) {%
        \global\caicedo@tras\z@\raggedright\spaceskip\z@\xspaceskip\z@\hyphenpenalty\@M\linespread{1}%
        \caicedo@linea{\caicedodisplay\fontsize{25.6}{26.88}\selectfont\color{cluz}}{\insertsectionhead}%
        \vskip 14.8\caicedo@px\hbox{\caicedobarra{18mm}}};
    \end{tikzpicture}
  \end{frame}}}
% El bloque (título + 34 px con la barra) queda centrado como el de revealjs (medido).
\newcommand*{\caicedo@secy}{4.34mm}

