% ---------------------------------------------------------------- Figuras
% «Figura n:» y «Tabla n:» en el mismo estilo que la leyenda, como en el HTML
% (Quarto escribe el rótulo como texto llano dentro de figcaption).
\addtokomafont{caption}{\small\color{cmuted}}
\addtokomafont{captionlabel}{\color{cmuted}}

% ---------------------------------------------------------------- Página
% Pie: isotipo + nombre a la izquierda, número mono turquesa a la derecha.
