% ---------------------------------------------------------------- Título
% El motivo encabeza la página (ancho del texto, alineado a la derecha); debajo, título en
% tinta extranegrita, subtítulo en dato, metadatos y resumen.
\renewcommand{\maketitle}{%
  \thispagestyle{caicedoprimera}%
  \begingroup\par\noindent
  \vspace*{-6mm}%
  \hfill\caicedomotivo[claro]{0.82\linewidth}\par
  \vspace{7mm}%
  {\raggedright\spaceskip\z@\xspaceskip\z@\hyphenpenalty\@M\exhyphenpenalty\@M
   {\caicedodisplay\fontsize{25}{28.5}\selectfont\color{ctinta}\@title\par}%
   \ifx\@subtitle\@empty\else\vspace{3mm}{\caicedomedio\fontsize{14}{17.5}\selectfont\color{cdatod}\@subtitle\par}\fi}%
  \vspace{6mm}%
  \caicedo@metadatos
  \vspace{5mm}\par\endgroup}
% Metadatos bajo el título, como en el HTML: rótulo en negrita pequeña y valor, en dos
% columnas con calle. Cada bloque sale solo si hay dato. Con varios autores (\and), uno por línea.
\newif\ifcaicedo@autor
\newif\ifcaicedo@fecha
\newcommand*{\caicedo@sinautor}{\@latex@warning@no@line{No \noexpand\author given}}
\newcommand*{\caicedo@buscaand}{\in@\and}
\newcommand*{\caicedo@metadatos}{%
  \caicedo@autortrue\caicedo@fechatrue
  \ifx\@author\@empty\caicedo@autorfalse\fi
  \ifx\@author\caicedo@sinautor\caicedo@autorfalse\fi
  \ifx\@date\@empty\caicedo@fechafalse\fi
  \ifcaicedo@autor\expandafter\caicedo@buscaand\expandafter{\@author}\else\in@false\fi
  \ifnum0\ifcaicedo@autor1\fi\ifcaicedo@fecha1\fi>0
    {\setlength{\parskip}{0pt}\parfillskip\z@skip\noindent
     \ifcaicedo@autor
       \begin{minipage}[t]{0.46\linewidth}%
         \caicedo@meta{\ifin@ Autores\else Autor\fi}{{\let\and\par\@author}}%
       \end{minipage}\hfill
     \fi
     \ifcaicedo@fecha
       \begin{minipage}[t]{0.46\linewidth}\caicedo@meta{Fecha de publicación}{\@date}\end{minipage}%
     \fi
     \hfill\par}%
  \fi}
\newcommand{\caicedo@meta}[2]{%
  {\leavevmode\fontsize{8.5}{10}\selectfont\bfseries\color{ctenue}#1\par}%
  \vspace{1mm}{\small\color{ctexto}\raggedright#2\par}}

% Resumen: rótulo en negrita de dato, como el HTML
\renewenvironment{abstract}
  {\par\noindent{\fontsize{9.5}{11}\selectfont\bfseries\color{cdatod}Resumen\par}\vspace{1mm}\small}
  {\par\vspace{4mm}}

% ---------------------------------------------------------------- Encabezados
% H2 del qmd = \section: extranegrita en tinta, número en dato, barra causal debajo.
\setkomafont{disposition}{\caicedodisplay\color{ctinta}}
\setkomafont{section}{\fontsize{16.5}{19.5}\selectfont}
\setkomafont{subsection}{\fontsize{13}{15.5}\selectfont\normalfont\bfseries\color{cdatod}}
\setkomafont{subsubsection}{\normalsize\normalfont\bfseries\color{ctinta}}
\setkomafont{paragraph}{\normalfont\bfseries\color{ctinta}}
\newcommand*{\caicedo@seccnt}[1]{\csname #1format\endcsname}
\AddToHook{begindocument/end}{%
  \let\@seccntformat\caicedo@seccnt
  \renewcommand*{\autodot}{}%
  \renewcommand*{\sectionformat}{{\normalfont\bfseries\color{cdatod}\addfontfeature{Numbers=Monospaced}\thesection}\enskip}%
  \renewcommand*{\subsectionformat}{{\normalfont\bfseries\color{ctenue}\addfontfeature{Numbers=Monospaced}\thesubsection}\enskip}%
  \renewcommand*{\subsubsectionformat}{{\normalfont\bfseries\color{ctenue}\thesubsubsection}\enskip}}
\RedeclareSectionCommand[beforeskip=-2.6ex plus -0.6ex, afterskip=1.5ex]{section}
\RedeclareSectionCommand[beforeskip=-2ex plus -0.4ex, afterskip=0.7ex]{subsection}
\renewcommand{\sectionlinesformat}[4]{%
  \ifstrequal{#1}{section}
    {\parbox{\linewidth}{\@hangfrom{\hskip #2#3}{#4}\par\nointerlineskip\vspace{2.2mm}\hbox{\caicedobarra{14mm}}}}
    {\@hangfrom{\hskip #2#3}{#4}}}

% Índice
\setkomafont{sectionentry}{\caicedodisplay\color{ctinta}}
\addtokomafont{sectionentrypagenumber}{\color{cdatod}}

% ---------------------------------------------------------------- Texto
\AtBeginDocument{\hypersetup{colorlinks=true,
  linkcolor=cdatod, urlcolor=cdatod, citecolor=cdatod, filecolor=cdatod}}
\let\caicedo@textbf\textbf
\renewcommand{\textbf}[1]{{\color{ctinta}\caicedo@textbf{#1}}}
% Viñetas por forma: disco (dato), círculo (grafo), cuadrado (tenue), como en el HTML.
\renewcommand{\labelitemi}{\textcolor{cdatod}{\raisebox{0.12ex}{\scalebox{0.85}{$\bullet$}}}}
\renewcommand{\labelitemii}{\textcolor{cgrafod}{\raisebox{0.05ex}{\tikz[baseline=0pt]\draw[line width=.07em] (0,.28em) circle (.2em);}}}
\renewcommand{\labelitemiii}{\textcolor{ctenue}{\raisebox{0.05ex}{\tikz[baseline=0pt]\fill (-.17em,.11em) rectangle (.17em,.45em);}}}
% Números = ol li::marker del HTML: negrita en dato, cifras tabulares.
\setlist[enumerate]{font=\color{cdatod}\bfseries\addfontfeature{Numbers=Monospaced}}
% Listas compactas, como las del HTML: poco aire entre elementos y menos aún en las anidadas.
\setlist[itemize,1]{topsep=0.35em, itemsep=0.2em, parsep=0pt}
\setlist[enumerate,1]{topsep=0.35em, itemsep=0.2em, parsep=0pt}
\setlist[itemize,2,3]{topsep=0.15em, itemsep=0.1em, parsep=0pt}
\setlist[enumerate,2,3]{topsep=0.15em, itemsep=0.1em, parsep=0pt}

% ---------------------------------------------------------------- Código
% Bloques: fondo papel, filo dato a la izquierda. En línea: Mono sobre papel, sin color propio.
\@ifundefined{shadecolor}{}{\colorlet{shadecolor}{cpapel}}
\newtcolorbox{caicedocodigo}{breakable, enhanced, frame hidden, boxrule=0pt,
  colback=cpapel, colupper=ctexto, arc=1.2pt, borderline west={2.4pt}{0pt}{cdatod},
  left=9pt, right=6pt, top=4pt, bottom=4pt, fontupper=\small}
\AtBeginDocument{%
  \@ifundefined{Shaded}{}{%
    \renewenvironment{Shaded}{\begin{caicedocodigo}}{\end{caicedocodigo}}}}
\let\caicedo@texttt\texttt
\renewcommand{\texttt}[1]{{\setlength{\fboxsep}{0.6pt}\colorbox{cpapel}{\vphantom{Ág}\kern1.8pt%
  {\fontsize{9.7}{12}\selectfont\color{ctexto}\caicedo@texttt{#1}}\kern1.8pt}}}

% ---------------------------------------------------------------- Tablas
\setlength{\heavyrulewidth}{1.4pt}
\setlength{\lightrulewidth}{0.6pt}
\renewcommand{\arraystretch}{1.3}
\AtBeginEnvironment{longtable}{\small\arrayrulecolor{ctinta}\addfontfeature{Numbers=Monospaced}}
\AtBeginEnvironment{tabular}{\small\arrayrulecolor{ctinta}}
% Encabezado = thead del HTML: negrita en tinta. Pandoc escribe la fila entre \toprule y
% \midrule; mientras dura, el comienzo de cada celda (\d@llarbegin, que array deja sin
% expandir en el preámbulo) añade la negrita. Las tablas con columnas p{} llevan el
% encabezado en una minipage, que mira el mismo interruptor. \bottomrule y el final de
% la tabla lo apagan siempre (tablas sin encabezado).
\newif\ifcaicedo@cabecera
\newcommand*{\caicedo@celdacab}{\begingroup\bfseries\color{ctinta}}
\newcommand*{\caicedo@cabon}{\noalign{\global\caicedo@cabeceratrue\global\let\d@llarbegin\caicedo@celdacab}}
\newcommand*{\caicedo@caboff}{\noalign{\global\caicedo@cabecerafalse\global\let\d@llarbegin\begingroup}}
\AtBeginEnvironment{longtable}{%
  \let\caicedo@toprule\toprule\def\toprule{\caicedo@cabon\caicedo@toprule}%
  \let\caicedo@midrule\midrule\def\midrule{\caicedo@caboff\caicedo@midrule}%
  \let\caicedo@bottomrule\bottomrule\def\bottomrule{\caicedo@caboff\caicedo@bottomrule}}
\AddToHook{env/longtable/after}{\global\caicedo@cabecerafalse\global\let\d@llarbegin\begingroup}
\AtBeginEnvironment{minipage}{\ifcaicedo@cabecera\bfseries\color{ctinta}\fi}
% En el HTML solo las tablas con etiqueta (#tbl-…) llevan «Tabla n:» y gastan número.
% longtable numera todas: aquí la leyenda sin \label sale sin rótulo y, al cerrar una tabla
% sin leyenda numerada, se devuelve el número. Las anclas de hyperref de las longtable
% usan su propio contador para no repetirse.
\newif\ifcaicedo@LTnum
\AtBeginEnvironment{longtable}{\global\caicedo@LTnumfalse}
\AddToHook{env/longtable/after}{\ifcaicedo@LTnum\else\global\advance\c@table\m@ne\fi}
\newcommand*{\caicedo@nombreLT}{longtable}
\AtBeginDocument{\@ifpackageloaded{longtable}{%
  \def\LT@capti@n{\@ifstar{\egroup\LT@c@ption\@gobble[]}{\caicedo@LTcap}}%
  \long\def\caicedo@LTcap#1{\@ifnextchar\label
    {\global\caicedo@LTnumtrue\egroup\LT@c@ption\@firstofone[{#1}]{#1}}
    {\in@\label{#1}%
     \ifin@\global\caicedo@LTnumtrue\egroup\LT@c@ption\@firstofone[{#1}]{#1}%
     \else\egroup\LT@c@ption\@gobble[]{#1}\fi}}}{}}
\AddToHook{begindocument/end}{\@ifpackageloaded{hyperref}{%
  \def\theHtable{\ifx\@currenvir\caicedo@nombreLT LT.\the\numexpr\c@LT@tables+1\relax\else\arabic{table}\fi}}{}}

% ---------------------------------------------------------------- Citas
\newtcolorbox{caicedocita}{breakable, enhanced, boxrule=0pt, frame hidden,
  colback=cpapel, colupper=ctexto, sharp corners, borderline west={2.4pt}{0pt}{cgrafod},
  left=10pt, right=8pt, top=6pt, bottom=6pt}
\renewenvironment{quote}{\begin{caicedocita}}{\end{caicedocita}}

% ---------------------------------------------------------------- Callouts de Quarto
% = div.callout del HTML: fondo papel sin marco, filo izquierdo de 3.4 pt del color del tipo y
% título en negrita del mismo color.
\AtBeginDocument{%
  \colorlet{quarto-callout-note-color}{cdatod}\colorlet{quarto-callout-note-color-frame}{cdatod}%
  \colorlet{quarto-callout-tip-color}{cgrafod}\colorlet{quarto-callout-tip-color-frame}{cgrafod}%
  \colorlet{quarto-callout-important-color}{ccausad}\colorlet{quarto-callout-important-color-frame}{ccausad}%
  \colorlet{quarto-callout-warning-color}{cavisod}\colorlet{quarto-callout-warning-color-frame}{cavisod}%
  \colorlet{quarto-callout-caution-color}{cavisod}\colorlet{quarto-callout-caution-color-frame}{cavisod}%
  \colorlet{quarto-callout-color}{ctenue}\colorlet{quarto-callout-color-frame}{ctenue}}
\newcommand*{\caicedo@callout}{%
  colupper=ctexto, colback=cpapel, opacityback=1, opacitybacktitle=1,
  code={\colorlet{caicedocallout}{tcbcolframe}},
  coltitle=caicedocallout, colbacktitle=cpapel,
  frame hidden, boxrule=0pt, titlerule=0pt, arc=1.5pt, boxsep=0pt,
  borderline west={3.4pt}{0pt}{caicedocallout},
  left=9pt, right=7pt, lefttitle=9pt, righttitle=7pt,
  before title=\strut, toptitle=4pt, bottomtitle=0pt, top=3pt, bottom=6.5pt,
  before skip=10pt plus 2pt, after skip=10pt plus 2pt,
  fonttitle=\bfseries\small, fontupper=\small,
  % Sin título (appearance="simple"): Quarto sube el texto 3 mm con \vspace{-3mm}.
  code={\ifx\kvtcb@title\@empty\tcbset{top=\dimexpr3mm+5pt\relax, bottom=4pt}\fi}}
\AddToHook{env/tcolorbox/begin}{\expandafter\tcbset@late@options\expandafter{\caicedo@callout}}
