% Interlineado = line-height 1.35 de revealjs: 14.85 pt (beamer usa 13.6 pt a 11 pt).
\linespread{1.0919}
% Quarto carga microtype: su protrusión y expansión dejan que beamer meta en una línea
% texto que en el navegador ya no cabe. Se apagan para que los cortes coincidan.
\@ifpackageloaded{microtype}{\microtypesetup{protrusion=false, expansion=false}}{}

% ---------------------------------------------------------------- Colores beamer
% Sobre blanco se usan las variantes oscuras (-d) de cada acento; las claras
% quedan para la portada oscura.
\setbeamercolor{background canvas}{bg=white}
\setbeamercolor{normal text}{fg=ctext, bg=white}
\setbeamercolor{structure}{fg=cdatod}
\setbeamercolor{alerted text}{fg=ccausad}
\setbeamercolor{example text}{fg=cgrafod}
\setbeamercolor{frametitle}{fg=cink}
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=cdato}
\setbeamercolor{author}{fg=white}
\setbeamercolor{date}{fg=cmuteddk}
\setbeamercolor{block title}{fg=cdatod, bg=}
\setbeamercolor{block body}{fg=ctext, bg=}
\setbeamercolor{block title alerted}{fg=ccausad, bg=}
\setbeamercolor{block title example}{fg=cgrafod, bg=}
\setbeamercolor{caption name}{fg=cink}
\setbeamercolor{caption}{fg=cmuted}
\setbeamercolor{footnote}{fg=cmuted}
\setbeamercolor{footnote mark}{fg=cdatod}
\hypersetup{colorlinks=true, linkcolor=cdatod, urlcolor=cdatod, citecolor=cdatod}
\setbeamertemplate{navigation symbols}{}

% Contenido alineado arriba, como revealjs (equivale a la opción de clase «t»).
\beamer@centeredfalse
% Bandera a la izquierda, como revealjs (beamer justifica por omisión).
\setbeamertemplate{frame begin}{\raggedright}
% Columnas sobre el ancho del texto, sin invadir los márgenes (como revealjs).
\beamer@onlytextwidthtrue
% Márgenes: 8 mm laterales (= 64 px)
\setbeamersize{text margin left=8mm, text margin right=8mm}

