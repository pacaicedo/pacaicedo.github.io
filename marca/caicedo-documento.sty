% caicedo-documento.sty — Documentos PDF de la marca P. E. Caicedo-Rodríguez.
% Gemelo visual de caicedo-documento.scss (HTML): misma paleta, fuentes,
% banda de título con el motivo de red causal, encabezados, código, tablas,
% citas y callouts. Comparte tokens con los otros cuatro archivos de la marca;
% si cambias uno, cámbialo en todos.
%
% Uso en el qmd (la carpeta marca/ junto al qmd):
%   format:
%     pdf:
%       documentclass: scrartcl
%       papersize: a4
%       fontsize: 10pt
%       pdf-engine: lualatex
%       shift-heading-level-by: -1   # ## = \section (h2 del HTML)
%       highlight-style: marca/caicedo-claro.theme
%       include-in-header:
%         text: \usepackage{marca/caicedo-documento}
%
% Requiere LuaLaTeX (o XeLaTeX), KOMA-Script y TikZ. Las fuentes se cargan por
% ruta desde marca/fuentes/, así el PDF no depende de las fuentes del sistema.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{marca/caicedo-documento}[2026/10/06 v1.1 Marca P. E. Caicedo-Rodríguez: documentos]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{tikz}
\usetikzlibrary{fadings}
\RequirePackage[most]{tcolorbox}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{enumitem}

