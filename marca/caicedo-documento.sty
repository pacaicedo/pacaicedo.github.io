% Filete degradado turquesa -> turquesa profundo -> dorado (firma de la marca).
\newcommand*{\caicedofilete}[2]{% {ancho}{grueso}
  \tikz[baseline]{\shade[left color=cdato, right color=ccausa, middle color=cgrafo] (0,0) rectangle (#1,#2);}}

% ---------------------------------------------------------------- Banda de título
% = .quarto-title-banner del HTML: tinta, motivo a la derecha, título blanco,
% subtítulo turquesa, metadatos en gris y filete degradado al pie.
% \caicedobanda es el alto mínimo; la banda crece si el título y el subtítulo no caben
% con 16 mm arriba y abajo (en el HTML la banda también crece con su contenido).
\newlength{\caicedobanda}
\setlength{\caicedobanda}{78mm}
\newlength{\caicedo@banda}
\newlength{\caicedo@artey}
\newsavebox{\caicedo@titulo}
\renewcommand{\maketitle}{%
  \thispagestyle{caicedoprimera}%
  % El bloque de texto se compone antes para medirlo.
  \sbox{\caicedo@titulo}{\begin{minipage}{0.62\paperwidth}%
    % Bandera a la izquierda, espacios naturales de cada fuente y sin guiones.
    \raggedright\spaceskip\z@\xspaceskip\z@\hyphenpenalty\@M\exhyphenpenalty\@M
    {\caicedomono\fontsize{7.5}{9}\selectfont\color{cdato}\addfontfeature{LetterSpace=22}DEL DATO A LA CAUSA\par}%
    \vspace{5mm}%
    {\caicedodisplay\bfseries\fontsize{25}{28}\selectfont\addfontfeature{LetterSpace=-1.5}\color{white}\@title\par}%
    \ifx\@subtitle\@empty\else\vspace{3mm}{\caicedodisplayreg\fontsize{13}{16}\selectfont\color{cdato}\@subtitle\par}\fi
  \end{minipage}}%
  \setlength{\caicedo@banda}{\dimexpr\ht\caicedo@titulo+\dp\caicedo@titulo+32mm\relax}%
  \ifdim\caicedo@banda<\caicedobanda\setlength{\caicedo@banda}{\caicedobanda}\fi
  % El motivo conserva su tamaño (88 % del alto mínimo) y se centra en el alto real.
  \setlength{\caicedo@artey}{\dimexpr(\caicedo@banda-0.88\caicedobanda)/2\relax}%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[cink] (current page.north west) rectangle ([yshift=-\caicedo@banda]current page.north east);
    \begin{scope}[shift={([xshift=-112mm, yshift=-\caicedo@artey]current page.north east)}]
      \setlength{\caicedo@u}{\dimexpr 0.88\caicedobanda/500\relax}%
      \begin{scope}[x=\caicedo@u, y=-\caicedo@u]\caicedo@arte\end{scope}
    \end{scope}
    \fill[cink, path fading=east] (current page.north west) rectangle ([xshift=-0.30\paperwidth, yshift=-\caicedo@banda]current page.north east);
    \fill[cink] (current page.north west) rectangle ([xshift=0.45\paperwidth, yshift=-\caicedo@banda]current page.north west);
    % middle color va al final: «right color» recalcula el centro como la media de los extremos.
    \shade[left color=cdato, right color=ccausa, middle color=cgrafo]
      ([yshift=-\caicedo@banda]current page.north west) rectangle ([yshift=-\caicedo@banda-1.1mm]current page.north east);
    \node[anchor=west, inner sep=0pt]
      at ([xshift=22mm, yshift=-0.5\caicedo@banda]current page.north west) {\usebox{\caicedo@titulo}};
  \end{tikzpicture}\par
  \vspace*{\dimexpr\caicedo@banda-\headheight-\headsep-\topskip-3mm\relax}%
  \caicedo@metadatos
  \vspace{5mm}\par}
% Metadatos bajo la banda, como en el HTML: rótulo mono y valor, en dos columnas con calle.
% Cada bloque sale solo si hay dato: sin author, LaTeX deja en \@author un aviso; sin date,
% pandoc escribe \date{}. Con varios autores (\and), uno por línea y rótulo en plural.
\newif\ifcaicedo@autor
\newif\ifcaicedo@fecha
\newcommand*{\caicedo@sinautor}{\@latex@warning@no@line{No \noexpand\author given}}
\newcommand*{\caicedo@buscaand}{\in@\and}
\newcommand*{\caicedo@metadatos}{%
  \caicedo@autortrue\caicedo@fechatrue
  \ifx\@author\@empty\caicedo@autorfalse\fi
  \ifx\@author\caicedo@sinautor\caicedo@autorfalse\fi
  \ifx\@date\@empty\caicedo@fechafalse\fi
  \ifcaicedo@autor\expandafter\caicedo@buscaand\expandafter{\@author}\else\in@false\fi
  \ifnum0\ifcaicedo@autor1\fi\ifcaicedo@fecha1\fi>0
    {\setlength{\parskip}{0pt}\parfillskip\z@skip\noindent
     \ifcaicedo@autor
       \begin{minipage}[t]{0.46\linewidth}%
         \caicedo@meta{\ifin@ AUTORES/AS\else AUTOR/A\fi}{{\let\and\par\@author}}%
       \end{minipage}\hfill
     \fi
     \ifcaicedo@fecha
       \begin{minipage}[t]{0.46\linewidth}\caicedo@meta{FECHA DE PUBLICACIÓN}{\@date}\end{minipage}%
     \fi
     \hfill\par}%
  \fi}
\newcommand{\caicedo@meta}[2]{% sin *: el valor puede llevar \par (un autor por línea)
  % \leavevmode antes de \color: la primera línea es la referencia de la minipage [t]
  % y las dos columnas quedan a la misma altura (con Ó o sin ella).
  {\leavevmode\caicedomono\fontsize{6.8}{8}\selectfont\color{cmuted}\addfontfeature{LetterSpace=16}#1\par}%
  \vspace{1.2mm}{\small\color{ctext}\raggedright#2\par}}

% Resumen: rótulo mono como el HTML
\renewenvironment{abstract}
  {\par\noindent{\caicedomono\fontsize{7.5}{9}\selectfont\color{cdatod}\addfontfeature{LetterSpace=16}RESUMEN\par}\vspace{1mm}\small}
  {\par\vspace{4mm}}

% ---------------------------------------------------------------- Encabezados
