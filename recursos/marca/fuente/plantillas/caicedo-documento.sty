% caicedo-documento.sty — Documentos PDF de la marca P. E. Caicedo-Rodríguez (v2).
% Gemelo visual de caicedo-documento.scss (HTML): misma paleta, letra, motivo sobre el
% título, encabezados con la barra causal, código, tablas, citas y callouts.
% Archivo generado por fuente/construir_marca.py desde fuente/plantillas/.
%
% Uso en el qmd (la ruta del \usepackage es relativa a la carpeta del qmd: en una subcarpeta,
% ../recursos/marca/..., ../../recursos/marca/...; las fuentes se encuentran solas):
%   format:
%     pdf:
%       documentclass: scrartcl
%       papersize: a4
%       fontsize: 11pt                # Atkinson tiene la x baja: 11 pt rinden como 10 pt de DejaVu
%       pdf-engine: lualatex
%       shift-heading-level-by: -1    # ## = \section (h2 del HTML)
%       highlight-style: recursos/marca/caicedo-claro.theme
%       include-in-header:
%         text: \usepackage{recursos/marca/caicedo-documento}
%   filters: [recursos/marca/caicedo.lua]
%
% La portada es clara a propósito: se imprime y se fotocopia sin gastar tóner en una banda.
% Requiere LuaLaTeX (o XeLaTeX), KOMA-Script y TikZ. Las fuentes se cargan por nombre si
% están instaladas y, si no, desde recursos/marca/fuentes/.
\NeedsTeXFormat{LaTeX2e}
% El nombre declarado es la ruta con la que se pidió el paquete: así no hay aviso de
% «You have requested package ...» al cargarlo desde una subcarpeta (../../recursos/marca/...).
\begingroup\edef\x{\endgroup\noexpand\ProvidesPackage{\ifx\CurrentFilePath\@empty\else\CurrentFilePath/\fi\@currname}}\x
  [2026/10/21 v2.1 Marca P. E. Caicedo-Rodríguez: documentos]
% Carpeta de este .sty (recursos/marca, ../../recursos/marca, ...): de aquí salen las fuentes.
\edef\caicedo@dir{\CurrentFilePath}

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{scrlayer-scrpage}
\RequirePackage{enumitem}

% Compatibilidad con KOMA-Script 3.49 y babel-spanish (incidencia #102).
% Desde 3.49.1 KOMA registra este hook con códigos de caracteres normales.
\ExplSyntaxOn
\str_if_eq:eeT { \KOMAScriptVersion } { 2025/12/01~v3.49~KOMA-Script }
  {
    \hook_gremove_code:nn { begindocument/end } { \KOMAClassName }
    \hook_gput_code:nnn { begindocument/end } { \KOMAClassName }
      {
        \cctab_begin:N \c_code_cctab
        \exp_args:Nne
        \hook_gput_code:nnn { cmd/@startsection/before } { \KOMAClassName }
          {
            \msg_warning:nnn { \KOMAClassName }
              { sectioning-features-not-available } { \@startsection }
          }
        \cctab_end:
      }
  }
\ExplSyntaxOff

