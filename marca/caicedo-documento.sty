% babel-spanish añade punto a los números de sección; se redefine al final del preámbulo.
\newcommand*{\caicedo@seccnt}[1]{\csname #1format\endcsname}
\AddToHook{begindocument/end}{%
  \let\@seccntformat\caicedo@seccnt
  \renewcommand*{\autodot}{}%
  \renewcommand*{\sectionformat}{{\caicedomono\mdseries\color{cdatod}\thesection}\enskip}%
  \renewcommand*{\subsectionformat}{{\caicedomono\mdseries\color{ccausad}\thesubsection}\enskip}%
  \renewcommand*{\subsubsectionformat}{{\caicedomono\mdseries\color{cmuted}\thesubsubsection}\enskip}}
\RedeclareSectionCommand[beforeskip=-2.6ex plus -0.6ex, afterskip=1.4ex]{section}
\RedeclareSectionCommand[beforeskip=-1.9ex plus -0.4ex, afterskip=0.7ex]{subsection}
\renewcommand{\sectionlinesformat}[4]{%
  \ifstrequal{#1}{section}
    {\parbox{\linewidth}{\@hangfrom{\hskip #2#3}{#4}\par\nointerlineskip\vspace{1.6mm}\hbox{\caicedofilete{12mm}{0.9pt}}}}
    {\@hangfrom{\hskip #2#3}{#4}}}

