\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{caicedo-diapositivas}[2026/10/20 v2 Diapositivas de proyeccion]
\providecommand{\caicedoroot}{recursos/marca/}
\input{\caicedoroot caicedo-base.sty}
\usefonttheme{professionalfonts}
\setbeamercolor{background canvas}{bg=cpaper}
\setbeamercolor{normal text}{fg=cink,bg=cpaper}
\setbeamercolor{structure}{fg=cviolet}
\setbeamercolor{alerted text}{fg=ccopper}
\setbeamercolor{frametitle}{fg=cink}
\setbeamercolor{title}{fg=cink}
\setbeamercolor{subtitle}{fg=cmuted}
\setbeamercolor{block title}{fg=cviolet,bg=csoft}
\setbeamercolor{block body}{fg=cink,bg=cpaper}
\setbeamersize{text margin left=8mm,text margin right=8mm}
\setbeamertemplate{navigation symbols}{}
\setbeamerfont{frametitle}{family=\caicedodisplay,series=\bfseries,size=\fontsize{20.6}{22.5}\selectfont}
\setbeamerfont{title}{family=\caicedodisplay,series=\bfseries,size=\fontsize{29.2}{30.2}\selectfont}
\setbeamerfont{subtitle}{family=\caicedodisplay,size=\fontsize{12.8}{16}\selectfont}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{12.8}{16.9}\selectfont}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{11}{14}\selectfont}
\AtBeginDocument{\renewcommand\normalsize{\fontsize{12.8}{16.9}\selectfont}\normalsize}
\setlength{\parskip}{.35em}
\setbeamertemplate{frametitle}{\vspace{4mm}\usebeamerfont{frametitle}\insertframetitle\par\vspace{2mm}{\color{cviolet}\rule{\textwidth}{.9pt}}\vspace{3mm}}
\setbeamertemplate{title page}{%
 \vspace{3mm}{\color{cviolet}\rule{\textwidth}{2.8pt}}\par\vspace{4mm}
 {\ttfamily\fontsize{7.1}{9}\selectfont\color{cviolet}BIOFORJA / CUADERNOS DE INGENIERÍA\par}\vspace{5mm}
 {\usebeamerfont{title}\raggedright\inserttitle\par}\vspace{4mm}
 {\usebeamerfont{subtitle}\color{cmuted}\insertsubtitle\par}\vspace{7mm}
 {\fontsize{9.2}{12}\selectfont\insertauthor\par}
 {\ttfamily\fontsize{7.1}{9}\selectfont\color{cmuted}\insertdate\par}}
\setbeamertemplate{footline}{\hspace{8mm}\raisebox{2.4mm}{\fontsize{6.4}{8}\selectfont\color{cmuted}\caicedonombre}\hfill\raisebox{2.4mm}{\fontsize{6.4}{8}\selectfont\color{cviolet}\insertframenumber/\inserttotalframenumber}\hspace{5mm}}
\setbeamertemplate{itemize item}{\textcolor{cviolet}{\rule{.4em}{.4em}}}
\setbeamertemplate{itemize subitem}{\textcolor{cviolet}{\small\textbullet}}
\setbeamertemplate{enumerate item}{\textcolor{cviolet}{\insertenumlabel.}}
\newcommand{\caicedomodooscuro}{%
 \setbeamercolor{background canvas}{bg=cink}\setbeamercolor{normal text}{fg=white,bg=cink}
 \colorlet{cviolet}{clight}\colorlet{ccopper}{csignal}\colorlet{cmuted}{clight}
 \setbeamercolor{frametitle}{fg=white}\setbeamercolor{title}{fg=white}
 \setbeamercolor{subtitle}{fg=clight}\setbeamercolor{structure}{fg=clight}
 \setbeamercolor{block title}{fg=cink,bg=clight}\setbeamercolor{block body}{fg=cink,bg=cpaper}}
