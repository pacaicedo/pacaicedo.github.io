  \colorlet{quarto-callout-warning-color}{caicedoaviso}\colorlet{quarto-callout-warning-color-frame}{caicedoaviso}%
  \colorlet{quarto-callout-caution-color}{caicedoaviso}\colorlet{quarto-callout-caution-color-frame}{caicedoaviso}%
  \colorlet{quarto-callout-color}{caicedotenue}\colorlet{quarto-callout-color-frame}{caicedotenue}}
\newcommand*{\caicedo@callouthook}{%
  \tcbset{colback=caicedopapel, opacityback=1, colupper=caicedotexto,
    opacitybacktitle=1, toprule=0pt, bottomrule=0pt, rightrule=0pt, leftrule=1mm, arc=0.5mm,
    boxsep=0pt, left=5.4pt, right=5.4pt, top=2.16pt, bottom=3.78pt,
    lefttitle=5.4pt, righttitle=5.4pt, toptitle=3.24pt, bottomtitle=0pt,
    before={\caicedo@antes{6.48pt}}, after={\caicedo@despues{6.48pt}}, halign=flush left, halign title=flush left,
    fonttitle=\caicedodisplay\linespread{1}\fontsize{10.8}{14.04}\selectfont,
    before title=\caicedo@puntal, after title=\caicedo@puntalfondo,
    fontupper=\linespread{1}\fontsize{10.8}{14.04}\selectfont,
    before upper=\caicedo@arribacaja, after upper=\caicedo@puntalfondo, code=\caicedo@guardar}%
  \tcbset{colback/.code={}, opacityback/.code={}, colupper/.code={}, coltitle/.code={},
    opacitybacktitle/.code={}, @colbacktitle/.code={}, toprule/.code={}, bottomrule/.code={},
    rightrule/.code={}, leftrule/.code={}, left/.code={}, toptitle/.code={}, bottomtitle/.code={},
    colframe/.code={\colorlet{tcbcolframe}{##1}\colorlet{tcbcoltitle}{##1}\colorlet{tcbcolbacktitle}{caicedopapel}}}}
\AddToHook{env/tcolorbox/begin}{\caicedo@callouthook}
