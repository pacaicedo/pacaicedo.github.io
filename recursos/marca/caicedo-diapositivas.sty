  \raisebox{0pt}{\caicedoisotipo[#1]{4mm}}\hspace{0.875mm}%
  \raisebox{1.43mm}{\caicedodisplay\fontsize{6.4}{6.4}\selectfont P.\,E. Caicedo-Rodríguez}\endgroup}
\setbeamertemplate{footline}{%
  \ifcaicedo@sala\caicedo@pieoscurotrue\fi
  \ifcaicedo@pieoscuro
    \def\caicedo@piemodo{noche}\def\caicedo@pietxt{ctenueluz}\def\caicedo@pienum{cluz}%
  \else
    \def\caicedo@piemodo{claro}\def\caicedo@pietxt{caicedotenue}\def\caicedo@pienum{caicedotitulo}%
  \fi
  \begin{tikzpicture}[x=1mm, y=1mm]
    \useasboundingbox (0,0) rectangle (\paperwidth,9);
    \node[anchor=south west, inner sep=0pt] at (3,2.25) {\expandafter\caicedo@firma\expandafter{\caicedo@piemodo}};
    \node[anchor=base east, inner sep=0pt] at ([xshift=-16.5mm]\paperwidth,3.4)
      {\fontsize{7.47}{8.96}\selectfont\color{\caicedo@pietxt}\caicedopie};
    \node[anchor=base east, inner sep=0pt] at ([xshift=-3.5mm]\paperwidth,3.4)
      {\fontsize{7.47}{8.96}\selectfont\addfontfeature{Numbers={Monospaced,Lining}}{\caicedodisplay\color{\caicedo@pienum}\insertframenumber}\hspace{.3em}{\color{\caicedo@pietxt}/}\hspace{.3em}{\caicedodisplay\color{\caicedo@pienum}\inserttotalframenumber}};
  \end{tikzpicture}%
  \global\caicedo@pieoscurofalse}

% ---------------------------------------------------------------- Portada
% = section#title-slide: fondo de portada, texto arriba a la izquierda (72 px = 9 mm del borde
% superior) y el motivo abajo a la derecha (980 px = 122.5 mm de ancho, a 5.5 mm del borde
% derecho y 8.25 mm del inferior).
\setbeamertemplate{title page}{%
  \ifcaicedo@sala\global\caicedo@pieoscurotrue\fi\global\caicedo@tras\z@
  \begin{tikzpicture}[remember picture, overlay]
    \fill[caicedoportada] (current page.south west) rectangle (current page.north east);
    \node[anchor=south east, inner sep=0pt] at ([xshift=-5.5mm, yshift=8.25mm]current page.south east)
      {\ifcaicedo@sala\caicedomotivo[oscuro]{122.5mm}\else\caicedomotivo[claro]{122.5mm}\fi};
    \node[anchor=north west, text width=144mm, align=left, inner sep=0pt]
      at ([xshift=8mm, yshift=-9mm]current page.north west) {%
        % Bandera a la izquierda, espacios naturales de cada fuente y sin guiones (como revealjs).
        \raggedright\spaceskip\z@\xspaceskip\z@\hyphenpenalty\@M\exhyphenpenalty\@M
        \linespread{1}%
        \caicedo@linea{\caicedodisplay\fontsize{28}{29.12}\selectfont\color{caicedotitulo}}{\inserttitle}%
        \vskip 2.25mm
        \ifx\beamer@subtitle\@empty\else
          \caicedo@linea{\fontsize{13.19}{15.83}\selectfont\color{caicedodato}}{\insertsubtitle}%
          \vskip 4.25mm
        \fi
        \ifx\beamer@shortauthor\@empty\else
          \caicedo@linea{\caicedodisplay\fontsize{10.67}{14.4}\selectfont\color{caicedotitulo}}{\insertauthor}%
        \fi
        \ifx\insertinstitute\@empty\else
          \vskip 0.25mm
          \caicedo@linea{\fontsize{9}{12.15}\selectfont\color{caicedotenue}}{\insertinstitute}%
        \fi
        \ifx\beamer@shortdate\@empty\else
          \vskip 0.75mm
          \caicedo@linea{\fontsize{9}{12.15}\selectfont\color{caicedotenue}}{\insertdate}%
        \fi
      };
  \end{tikzpicture}}

% Un renglón (o párrafo) con cajas de línea de CSS arriba y abajo: {fuente}{texto}.
\newcommand{\caicedo@linea}[2]{\par\nointerlineskip{#1\caicedo@puntal#2\caicedo@puntalfondo\par}\nointerlineskip}
% Sin fecha en el qmd no hay fecha en la portada (beamer pondría la de hoy), como en revealjs.
